<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?attr/litsBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LitS" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:textSize="24sp" android:textColor="?attr/litsAccent" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="Create your account" android:fontFamily="sans-serif-medium" android:textSize="28sp" android:textColor="?attr/litsText" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Create an account and add your voice to the journal." android:textSize="16sp" android:textColor="?attr/litsMuted" android:lineSpacingExtra="4dp" />
        <TextView style="@style/LitsLabel" android:layout_marginTop="24dp" android:text="Email address" android:labelFor="@id/register_email" />
        <EditText android:id="@+id/register_email" style="@style/LitsInput" android:layout_marginTop="8dp" android:hint="you@example.com" android:inputType="textEmailAddress" />
        <TextView style="@style/LitsLabel" android:layout_marginTop="24dp" android:text="Password" android:labelFor="@id/register_password" />
        <EditText android:id="@+id/register_password" style="@style/LitsInput" android:layout_marginTop="8dp" android:hint="Choose a password" android:inputType="textPassword" />
        <TextView style="@style/LitsLabel" android:layout_marginTop="24dp" android:text="Confirm password" android:labelFor="@id/register_confirm_password" />
        <EditText android:id="@+id/register_confirm_password" style="@style/LitsInput" android:layout_marginTop="8dp" android:hint="Repeat your password" android:inputType="textPassword" />
        <com.google.android.material.button.MaterialButton android:id="@+id/register_create_account" style="@style/LitsButton" android:layout_marginTop="28dp" android:text="Create account" />
    </LinearLayout>
</ScrollView>
