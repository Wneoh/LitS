<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp"
    android:orientation="vertical" android:background="?attr/litsSoftAccent">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LitS"
        android:textSize="24sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:textColor="?attr/litsAccent" />
    <de.hdodenhof.circleimageview.CircleImageView android:id="@+id/nav_profile_mage"
        android:layout_width="56dp" android:layout_height="56dp" android:layout_marginTop="24dp"
        android:src="@drawable/profile" android:contentDescription="Your profile photo" />
    <TextView android:id="@+id/nav_user_full_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Your journal" android:textSize="18sp" android:textColor="?attr/litsText" />
</LinearLayout>
