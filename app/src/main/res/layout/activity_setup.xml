<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?attr/litsBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Make it yours"
            android:textSize="28sp" android:fontFamily="sans-serif-medium" android:textColor="?attr/litsText" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Introduce yourself to the community." android:textSize="15sp" android:textColor="?attr/litsMuted" />
        <de.hdodenhof.circleimageview.CircleImageView android:id="@+id/setup_profile_image" android:layout_width="80dp"
            android:layout_height="80dp" android:layout_gravity="center_horizontal" android:layout_marginTop="24dp"
            android:src="@drawable/profile" android:contentDescription="Choose a profile photo" android:focusable="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:text="Tap to add a photo" android:textSize="12sp" android:textColor="?attr/litsMuted" android:layout_marginTop="8dp" />
        <TextView style="@style/LitsLabel" android:layout_marginTop="24dp" android:text="Username" android:labelFor="@id/setup_username" />
        <EditText android:id="@+id/setup_username" style="@style/LitsInput" android:layout_marginTop="8dp" android:hint="Your username" android:inputType="text" />
        <TextView style="@style/LitsLabel" android:layout_marginTop="16dp" android:text="Full name" android:labelFor="@id/setup_full_name" />
        <EditText android:id="@+id/setup_full_name" style="@style/LitsInput" android:layout_marginTop="8dp" android:hint="Your name" android:inputType="textPersonName" />
        <TextView style="@style/LitsLabel" android:layout_marginTop="16dp" android:text="Country" android:labelFor="@id/setup_country_name" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/setup_country_name" style="@style/LitsInput" android:layout_marginTop="8dp"
            android:text="Select country  ›" android:textAllCaps="false" android:gravity="center_vertical|start" />
        <TextView style="@style/LitsLabel" android:layout_marginTop="16dp" android:text="Gender" android:labelFor="@id/setup_gender" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/setup_gender" style="@style/LitsInput" android:layout_marginTop="8dp"
            android:text="Select gender  ›" android:textAllCaps="false" android:gravity="center_vertical|start" />
        <com.google.android.material.button.MaterialButton android:id="@+id/setup_information_button"
            style="@style/LitsButton" android:layout_marginTop="24dp" android:text="Save profile" />
    </LinearLayout>
</ScrollView>
