<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="?attr/litsBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="28dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="48dp" android:layout_height="48dp" android:gravity="center"
                android:background="@drawable/brand_mark" android:text="L" android:textSize="28sp"
                android:fontFamily="serif" android:textStyle="bold" android:textColor="?attr/litsOnAccent" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:text="LitS" android:textSize="24sp" android:fontFamily="sans-serif-medium" android:textColor="?attr/litsText" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="36dp"
            android:text="Welcome back" android:fontFamily="sans-serif-medium" android:textSize="28sp" android:textColor="?attr/litsText" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="A little reading. A little writing. A place for you." android:textSize="15sp"
            android:textColor="?attr/litsMuted" android:lineSpacingExtra="4dp" />
        <TextView style="@style/LitsLabel" android:layout_marginTop="28dp" android:labelFor="@id/login_email" android:text="Email address" />
        <EditText android:id="@+id/login_email" style="@style/LitsInput" android:layout_marginTop="8dp"
            android:hint="you@example.com" android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:imeOptions="actionNext" />
        <TextView style="@style/LitsLabel" android:layout_marginTop="18dp" android:labelFor="@id/login_password" android:text="Password" />
        <com.google.android.material.textfield.TextInputLayout xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            app:hintEnabled="false" app:endIconMode="password_toggle" app:boxBackgroundMode="none">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/login_password" style="@style/LitsInput"
                android:hint="Enter your password" android:inputType="textPassword" android:autofillHints="password"
                android:paddingTop="0dp" android:paddingBottom="0dp" android:gravity="center_vertical" android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/login" style="@style/LitsButton"
            android:layout_marginTop="24dp" android:text="Sign in" />
        <TextView android:id="@+id/NeedNewAccountLink" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:gravity="center" android:layout_marginTop="12dp" android:padding="12dp"
            android:text="New to LitS? Create an account" android:textColor="?attr/litsAccent" android:textSize="14sp"
            android:fontFamily="sans-serif-medium" android:background="?attr/selectableItemBackground" android:focusable="true" />
        <TextView android:id="@+id/choose_theme" android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center" android:text="Choose your theme" android:textSize="14sp" android:textColor="?attr/litsMuted"
            android:background="?attr/selectableItemBackground" android:focusable="true" android:clickable="true" />
    </LinearLayout>
</ScrollView>
